# Copy this file to web/.env and fill in your values.
# web/.env is gitignored — never commit real credentials.

# Courted login (used by the Courted engine).
COURTED_EMAIL=you@example.com
COURTED_PASSWORD=your-password
# Optional: extra Courted accounts. Each account can see a different MLS, so the
# scraper runs the search on ALL of them and merges + de-duplicates the results.
# Add as many as you need (_2, _3, … up to _20).
# COURTED_EMAIL_2=second@example.com
# COURTED_PASSWORD_2=second-password
# COURTED_EMAIL_3=third@example.com
# COURTED_PASSWORD_3=third-password

# Zillow residential proxy. Format: http://user:pass@host:port
# Leave empty to run without a proxy (Zillow will likely block).
ZILLOW_PROXY_URL=

# Optional: port for the webapp (default 3000).
PORT=3000

# Optional: Supabase persistence. When BOTH are set, every scrape is upserted to
# Supabase (re-scraping a market updates rows instead of duplicating). Leave
# empty to disable (the app runs exactly as before). Run web/server/schema.sql
# in your Supabase project once to create the tables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ZenRows API key (for realtor.com and other hard-blocked sites)
ZENROWS_API_KEY=

# Web unblocker for realtor.com — set ONE provider.
# Bright Data Web Unlocker (PAYG, cheapest):
UNBLOCKER_PROVIDER=brightdata
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_ZONE=web_unlocker1
